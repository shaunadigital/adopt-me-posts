{
  "id": "dogOfTheWeek0001",
  "name": "Dog of the week",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Pacific/Honolulu"
  },
  "nodes": [
    {
      "id": "6f0c1a10-0001-4c5e-9a01-000000000001",
      "name": "Every Monday 9:00 AM (Hawaii)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "6f0c1a10-0002-4c5e-9a01-000000000002",
      "name": "Run now (testing)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "6f0c1a10-0003-4c5e-9a01-000000000003",
      "name": "Get dog of the week",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 100],
      "parameters": {
        "method": "GET",
        "url": "https://adopt-me-posts.vercel.app/api/dogs",
        "options": {}
      }
    },
    {
      "id": "6f0c1a10-0004-4c5e-9a01-000000000004",
      "name": "Upload photo to Blotato",
      "type": "@blotato/n8n-nodes-blotato.blotato",
      "typeVersion": 2,
      "position": [480, 100],
      "parameters": {
        "resource": "media",
        "operation": "upload",
        "useBinaryData": false,
        "mediaUrl": "={{ $json.dogOfTheWeek.photoUrl }}"
      }
    },
    {
      "id": "6f0c1a10-0005-4c5e-9a01-000000000005",
      "name": "Post to Bluesky",
      "type": "@blotato/n8n-nodes-blotato.blotato",
      "typeVersion": 2,
      "position": [720, 100],
      "parameters": {
        "resource": "post",
        "operation": "create",
        "platform": "bluesky",
        "accountId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "postContentText": "={{ $('Get dog of the week').item.json.dogOfTheWeek.caption }}",
        "postContentMediaUrls": "={{ $json.url }}"
      }
    },
    {
      "id": "6f0c1a10-0006-4c5e-9a01-000000000006",
      "name": "Wait 30 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [960, 100],
      "parameters": {
        "amount": 30
      },
      "webhookId": "6f0c1a10-0006-4c5e-9a01-0000000000a6"
    },
    {
      "id": "6f0c1a10-0007-4c5e-9a01-000000000007",
      "name": "Check post status",
      "type": "@blotato/n8n-nodes-blotato.blotato",
      "typeVersion": 2,
      "position": [1200, 100],
      "parameters": {
        "resource": "post",
        "operation": "get",
        "postSubmissionId": "={{ $('Post to Bluesky').item.json.postSubmissionId }}"
      }
    },
    {
      "id": "6f0c1a10-0008-4c5e-9a01-000000000008",
      "name": "Setup note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [220, -260],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Dog of the week\nEvery Monday at 9:00 AM Hawaii time, posts the next dog (Mochi, Biscuit, Rocket, Pepper, Pip, Tank) to Bluesky with its starter caption and photo from adopt-me-posts.vercel.app.\n\n**Before activating:** install the Blotato community node (`@blotato/n8n-nodes-blotato`), create a **Blotato API** credential with your key, select it on the three Blotato nodes, and pick the Bluesky account in **Post to Bluesky**. The key lives only in the n8n credential."
      }
    }
  ],
  "connections": {
    "Every Monday 9:00 AM (Hawaii)": {
      "main": [[{ "node": "Get dog of the week", "type": "main", "index": 0 }]]
    },
    "Run now (testing)": {
      "main": [[{ "node": "Get dog of the week", "type": "main", "index": 0 }]]
    },
    "Get dog of the week": {
      "main": [[{ "node": "Upload photo to Blotato", "type": "main", "index": 0 }]]
    },
    "Upload photo to Blotato": {
      "main": [[{ "node": "Post to Bluesky", "type": "main", "index": 0 }]]
    },
    "Post to Bluesky": {
      "main": [[{ "node": "Wait 30 seconds", "type": "main", "index": 0 }]]
    },
    "Wait 30 seconds": {
      "main": [[{ "node": "Check post status", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {}
}
